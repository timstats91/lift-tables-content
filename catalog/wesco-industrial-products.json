            ],
            "sources": [
                "https://catalog.wescomfg.com/viewitems/lift-equipment/-from-200-to-6000-lb-manual-and-powered-lift"
            ],
            "capacity_range": "200–6,000 lbs"
        },
        {
            "slug": "wesco-scissor-lift-tables-and-carts",
            "title": "Wesco Scissor Lift Tables and Carts",
            "excerpt": "Foot-pump and powered scissor lift carts rated 330 to 2,200 lb, with single, double scissor and long deck models.",
            "content": "<p>Wesco's scissor lift carts raise loads with a foot-operated hydraulic pump and roll on locking casters, with folding or fixed handles. The range includes single scissor carts, double scissor high lift carts with up to 59 in. of raised height, long deck carts up to 30 x 80 in. and a roller top model.</p>\n<p>Capacities run from 330 to 2,200 lb. PSLT carts add a powered lift, and the MELT is a 2,200 lb mini electric scissor lift table that lowers to 7 in. The DT-2436 is a 2,000 lb hydraulic die lift table.</p>",
            "line_code": "LT-SL / PSLT",
            "key_features": [
                "330 to 2,200 lb capacities",
                "Foot-operated hydraulic pump",
                "Single and double scissor models",
                "Powered PSLT carts",
                "Locking casters"
            ],
