        {
            "slug": "phs-standard-duty-lift-tables",
            "title": "Premier Handling Standard Duty Lift Tables",
            "excerpt": "Economical heavy-duty hydraulic scissor lift tables rated 2,000 to 6,000 lb, with 24 to 60 in. of travel.",
            "content": "<p>PHS Standard Duty Lift Tables are economical hydraulic scissor lifts for improving operator ergonomics and productivity. Internal power units, heavy-duty cylinders and tubular legs, safety maintenance blocks, lifetime lubricated bearings and standard hand controls are standard.</p>\n<p>Models are rated 2,000, 4,000 or 6,000 lb with 24, 36, 48 or 60 in. of travel, lowering to 7-1/2 or 10 in., with standard platforms from 24 x 36 in. and maximum platforms up to 48 x 120 in. Options include accordion skirts, oversized or bevelled platforms, pit mounting, a portability package, turntable or tilt table tops, conveyors, PLC control, foot pedal control, an external power unit and a high cycle package.</p>",
            "line_code": "Standard Duty",
            "key_features": [
                "2,000 to 6,000 lb capacities",
                "24 to 60 in. of travel",
                "Internal power unit",
                "Heavy-duty cylinders",
                "Safety maintenance blocks",
                "Lifetime lubricated bearings"
            ],
            "categories": [
                "Lift Tables > Scissor Lift Tables",
                "Lift Tables > Hydraulic Lift Tables",
                "Lift Tables > Electric Lift Tables"
            ],
            "sources": [
                "https://www.phsinc.com/lift-tables/standard-duty-lift-table/"
            ],
            "capacity_range": "2,000–6,000 lbs"
        },
        {
            "slug": "phs-heavy-duty-lift-tables",
            "title": "Premier Handling Heavy Duty Lift Tables",
            "excerpt": "Heavy-duty hydraulic scissor lift tables rated 8,000 or 10,000 lb, with 30 to 60 in. of travel and a 3 HP motor.",
            "content": "<p>PHS Heavy Duty Lift Tables are hydraulic scissor lifts for heavier loads, with internal power units, heavy-duty cylinders and tubular legs, safety maintenance blocks, lifetime lubricated bearings and standard hand controls.</p>\n<p>Models are rated 8,000 or 10,000 lb with 30, 40, 48 or 60 in. of travel, a 12 in. lowered height and a 3 HP motor, on standard 36 in. wide platforms up to 48 x 108 in. Options include accordion skirts, oversized or bevelled platforms, pit mounting, a portability package, turntable or tilt table tops, conveyors, PLC control, foot pedal control, an external power unit and a high cycle package.</p>",
            "line_code": "Heavy Duty",
            "key_features": [
